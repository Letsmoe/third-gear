#pragma once
// Facade, roof and cladding surfaces from scanned texture sets (Scripts/create_facade_materials.py). Needs TerrainNoise.ush
// (DgValueNoise). Everything is a plain function so the weathering overlay (#84) and other agents' materials can call it too.

float3 DgRgbToHsv(float3 Rgb)
{
	float4 K = float4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
	float4 P = lerp(float4(Rgb.bg, K.wz), float4(Rgb.gb, K.xy), step(Rgb.b, Rgb.g));
	float4 Q = lerp(float4(P.xyw, Rgb.r), float4(Rgb.r, P.yzx), step(P.x, Rgb.r));
	float Delta = Q.x - min(Q.w, Q.y);
	return float3(abs(Q.z + (Q.w - Q.y) / (6.0 * Delta + 1e-6)), Delta / (Q.x + 1e-6), Q.x);
}

float3 DgHsvToRgb(float3 Hsv)
{
	float3 P = abs(frac(Hsv.xxx + float3(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
	return Hsv.z * lerp(float3(1, 1, 1), saturate(P - 1.0), Hsv.y);
}

/** Shifts the hue (in turns), scales saturation and value. Hue shifting is how one brick scan becomes deep red, brown and yellow. */
float3 DgFacadeShift(float3 Color, float HueShift, float Saturation, float Value)
{
	float3 Hsv = DgRgbToHsv(max(Color, 0.0));
	Hsv.x = frac(Hsv.x + HueShift + 1.0);
	Hsv.y = saturate(Hsv.y * Saturation);
	Hsv.z = Hsv.z * Value;
	return DgHsvToRgb(Hsv);
}

/**
 * Gives the scan the colour Target (linear) while keeping its own light and dark variation: the scan's brightness relative to
 * its mean, tinted with Target's hue. Amount 0 keeps the scan's colour.
 */
float3 DgFacadeRecolor(float3 Color, float3 ScanMean, float3 Target, float Amount)
{
	float Relative = dot(Color, float3(0.2126, 0.7152, 0.0722)) / max(dot(ScanMean, float3(0.2126, 0.7152, 0.0722)), 1e-4);
	return lerp(Color, Target * Relative, Amount);
}

struct FDgFacadeSurface
{
	float3 Color;
	float2 NormalXY;
	float Roughness;
	float AO;
};

/**
 * The scan at Uv. With AntiTile above 0 a second copy of the scan, rotated, scaled and shifted, is mixed in where a
 * low-frequency noise says so, which hides the repeat on isotropic surfaces (render, concrete). Leave it 0 on brick,
 * whose courses must stay level. Metres is a position in metres (any continuous mapping of the surface) that drives the noise.
 */
FDgFacadeSurface DgFacadeSampleSurface(Texture2D ColorMap, SamplerState ColorSampler, Texture2D NormalMap, SamplerState NormalSampler,
	Texture2D RoughMap, SamplerState RoughSampler, Texture2D OcclusionMap, SamplerState OcclusionSampler, float2 Uv, float2 Metres, float AntiTile)
{
	FDgFacadeSurface Surface;
	Surface.Color = Texture2DSample(ColorMap, ColorSampler, Uv).rgb;
	Surface.NormalXY = Texture2DSample(NormalMap, NormalSampler, Uv).xy * 2.0 - 1.0;
	Surface.Roughness = Texture2DSample(RoughMap, RoughSampler, Uv).r;
	Surface.AO = Texture2DSample(OcclusionMap, OcclusionSampler, Uv).r;
	if (AntiTile > 0.0)
	{
		float Mix = smoothstep(0.35, 0.65, DgValueNoise(Metres / 6.3 + 11.7)) * AntiTile;
		float2x2 Turn = float2x2(0.809, -0.588, 0.588, 0.809);
		float2 UvB = mul(Turn, Uv) * 0.73 + float2(0.37, 0.61);
		float3 ColorB = Texture2DSample(ColorMap, ColorSampler, UvB).rgb;
		// Turning the texture turns its normals with it, so rotate them back.
		float2 NormalB = Texture2DSample(NormalMap, NormalSampler, UvB).xy * 2.0 - 1.0;
		NormalB = mul(NormalB, Turn);
		Surface.Color = lerp(Surface.Color, ColorB * dot(Surface.Color, 0.333) / max(dot(ColorB, 0.333), 1e-3), Mix * 0.7);
		Surface.NormalXY = lerp(Surface.NormalXY, NormalB, Mix * 0.7);
		Surface.Roughness = lerp(Surface.Roughness, Texture2DSample(RoughMap, RoughSampler, UvB).r, Mix * 0.7);
		Surface.AO = lerp(Surface.AO, Texture2DSample(OcclusionMap, OcclusionSampler, UvB).r, Mix * 0.7);
	}
	return Surface;
}

/** Brightness of one building relative to its neighbours plus a slow variation across the wall, so no two facades look cut from one sheet. */
float DgFacadeBrightness(float BuildingTint, float TintMin, float TintMax, float2 Metres)
{
	float Patchy = lerp(0.93, 1.06, DgValueNoise(Metres / 4.7 + 3.1)) * lerp(0.97, 1.03, DgValueNoise(Metres / 1.3 + 8.4));
	return lerp(TintMin, TintMax, BuildingTint) * Patchy;
}

/**
 * Fine trowel or float texture for smooth render, from rotated noise octaves that fade out under minification: a low
 * amplitude tilt for the normal (Tilt) and a roughness offset. Strength 0 gives nothing. Needs MarkingWear.ush (DgWearNoise).
 */
void DgFacadeFineGrain(float2 Metres, float Strength, out float2 Tilt, out float RoughnessOffset)
{
	float Step = 0.004;
	float Fine = DgWearNoise(Metres, 150.0, 0.3) * 0.5 + DgWearNoise(Metres, 61.0, 1.1) * 0.5;
	float FineX = DgWearNoise(Metres + float2(Step, 0), 150.0, 0.3) * 0.5 + DgWearNoise(Metres + float2(Step, 0), 61.0, 1.1) * 0.5;
	float FineY = DgWearNoise(Metres + float2(0, Step), 150.0, 0.3) * 0.5 + DgWearNoise(Metres + float2(0, Step), 61.0, 1.1) * 0.5;
	// Float strokes: broad, slightly curved ridges at about 8 per metre.
	float Stroke = DgWearNoise(Metres * float2(1.0, 0.45), 9.0, 0.7);
	float StrokeX = DgWearNoise((Metres + float2(0.01, 0)) * float2(1.0, 0.45), 9.0, 0.7);
	float StrokeY = DgWearNoise((Metres + float2(0, 0.01)) * float2(1.0, 0.45), 9.0, 0.7);
	Tilt = (float2(FineX - Fine, FineY - Fine) / Step * 0.012 + float2(StrokeX - Stroke, StrokeY - Stroke) / 0.01 * 0.012) * Strength;
	RoughnessOffset = ((Fine - 0.5) * 0.12 + (Stroke - 0.5) * 0.1) * Strength;
}
