#pragma once
// Weathering of facade materials (Scripts/create_facade_materials.py, #84): rain streaks below sills, a dirty and splashed
// plinth, algae and moss on north faces and low wet areas, render and mortar repairs, faded and flaking paint. Nothing
// repeats: every effect is placed by hashing cells of the wall, seeded by the building's variation value, the way the road
// cracks are (RoadCracks.ush). Needs TerrainNoise.ush and MarkingWear.ush (DgWearNoise: rotated octaves that fade out under
// minification, so distant walls don't shimmer).
//
// Wall space: u metres along the wall, h metres above the building's base (the mesher's UV is (u, -h)).

#define DG_ATLAS_COLUMNS 4.0
#define DG_ATLAS_ROWS 2.0

// What the weathering changes at one pixel.
struct FDgFacadeWeathering
{
	float3 Color;
	float Roughness;
	float2 NormalTilt;
};

/** Atlas tile Index (0..7) at tile-local coordinates in 0..1, sampled with explicit gradients so cell borders keep their mip. */
float DgAtlasMask(Texture2D Atlas, SamplerState AtlasSampler, float Index, float2 Local, float2 GradientX, float2 GradientY)
{
	float2 Origin = float2(fmod(Index, DG_ATLAS_COLUMNS), floor(Index / DG_ATLAS_COLUMNS));
	float2 Uv = (Origin + saturate(Local)) / float2(DG_ATLAS_COLUMNS, DG_ATLAS_ROWS);
	float2 Scale = 1.0 / float2(DG_ATLAS_COLUMNS, DG_ATLAS_ROWS);
	return Atlas.SampleGrad(AtlasSampler, Uv, GradientX * Scale, GradientY * Scale).r;
}

/**
 * Dark streaks running down from the sill of each window (cell: one window column of width Spacing, one floor of height
 * FloorHeight, the same grid as the painted windows), so they line up with windows without being stamped under every one.
 * A cell holds a streak with a probability that grows with Age; it picks one of two atlas shapes, its width, length and
 * a sideways shift. Returns the darkening 0..1.
 */
float DgSillStreaks(Texture2D Atlas, SamplerState AtlasSampler, float2 Wall, float2 WallDx, float2 WallDy, float Seed,
	float Spacing, float FloorHeight, float Age)
{
	float Floor = floor(Wall.y / FloorHeight);
	float Column = floor(Wall.x / Spacing);
	float Streak = 0.0;
	// This floor's sill streak, and the one from the floor above that is long enough to reach down here.
	[unroll]
	for (int Above = 0; Above < 2; ++Above)
	{
		float2 Cell = float2(Column, Floor + Above);
		float Roll = DgHash(Cell + Seed * 17.3);
		if (Roll > 0.15 + 0.7 * Age)
		{
			continue;
		}
		float Pick = DgHash(Cell + Seed * 3.1 + 7.7);
		float Width = lerp(0.5, 1.0, DgHash(Cell + 2.2)) * Spacing * 0.5;
		float Length = lerp(1.0, 2.6, DgHash(Cell + 5.5)) * (0.6 + 0.6 * Age);
		float Centre = (Column + 0.5 + (DgHash(Cell + 9.9) - 0.5) * 0.16) * Spacing;
		float SillHeight = (Floor + Above + 0.32) * FloorHeight;
		float2 Local = float2((Wall.x - Centre) / Width * 0.5 + 0.5, (SillHeight - Wall.y) / Length);
		if (Local.y < -0.08 || Local.y > 1.0 || Local.x < 0.0 || Local.x > 1.0)
		{
			continue;
		}
		// The atlas shapes carry the ledge in the upper third; the drips run down from there.
		float2 Tile = float2(Local.x, lerp(0.30, 1.0, saturate(Local.y)));
		float2 TileDx = float2(WallDx.x / (Width * 2.0), WallDx.y / Length * 0.7);
		float2 TileDy = float2(WallDy.x / (Width * 2.0), WallDy.y / Length * 0.7);
		float Index = Pick < 0.5 ? 1.0 : 0.0;
		Streak = max(Streak, DgAtlasMask(Atlas, AtlasSampler, Index, Tile, TileDx, TileDy) * smoothstep(-0.08, 0.04, Local.y));
	}
	return Streak;
}

/** Long faint rain wash down the whole wall: stretched noise, stronger near the top where the water has run furthest. */
float DgRainWash(float2 Wall, float Seed, float Age)
{
	float Stretched = DgWearNoise(Wall * float2(1.0, 0.12) + Seed * 31.0, 5.5, 0.15) * 0.6
		+ DgWearNoise(Wall * float2(1.0, 0.2) + Seed * 11.0, 17.0, 0.55) * 0.4;
	return saturate((Stretched - 0.45) * 2.2) * Age * 0.5;
}

/** Splash and dirt at the foot of the wall: 0..1, densest at the ground, broken up by noise and splash dots. */
float DgPlinthDirt(Texture2D Atlas, SamplerState AtlasSampler, float2 Wall, float2 WallDx, float2 WallDy, float PlinthHeight, float Age)
{
	float Ragged = DgWearNoise(Wall, 3.1, 0.7) * 0.6 + DgWearNoise(Wall, 9.3, 1.9) * 0.4;
	float Band = 1.0 - smoothstep(0.0, PlinthHeight * (0.7 + 0.8 * Ragged), Wall.y);
	float2 Local = frac(Wall / 1.3);
	float2 Scale = 1.0 / 1.3;
	float Dots = DgAtlasMask(Atlas, AtlasSampler, 4.0, Local, WallDx * Scale, WallDy * Scale);
	float Splash = Dots * (1.0 - smoothstep(0.0, PlinthHeight * 2.2, Wall.y));
	return saturate(Band * (0.55 + 0.45 * Age) + Splash * 0.6 * Age);
}

/**
 * Algae and moss: more on faces turned away from the sun (north is -y in this world, WorldNormalY < 0), near the ground where
 * water collects, and in damp patches. Returns the algae film 0..1 and, in Clumps, where actual moss grows.
 */
float DgAlgae(float2 Wall, float Seed, float WorldNormalY, float Age, out float Clumps)
{
	float North = saturate(-WorldNormalY * 0.75 + 0.25);
	float Low = saturate(1.0 - Wall.y / 2.8);
	float Damp = DgWearNoise(Wall + Seed * 13.0, 0.55, 0.3) * 0.65 + DgWearNoise(Wall + Seed * 5.0, 1.9, 1.3) * 0.35;
	float Film = saturate((Damp * 0.55 + North * 0.45 + Low * 0.35 - 0.62) * 3.0) * Age;
	float ClumpNoise = DgWearNoise(Wall, 11.0, 0.9) * 0.55 + DgWearNoise(Wall, 27.0, 2.3) * 0.45;
	float Wide = max(0.1, fwidth(ClumpNoise) * 1.5);
	Clumps = smoothstep(0.62, 0.62 + Wide, ClumpNoise) * saturate((Film - 0.45) * 2.0) * saturate(1.0 - Wall.y / 1.2);
	return Film;
}

/**
 * Repairs: rectangles of patched render or mortar, 0.5 to 1.4 m wide, in cells of the wall. x = inside a patch, y = its edge
 * (a chipped, slightly raised border). Patches are lighter and smoother than what they sit on.
 */
float2 DgRepairs(float2 Wall, float Seed, float Amount, float Age)
{
	float2 Cell = floor(Wall / float2(1.7, 1.3));
	float Roll = DgHash(Cell + Seed * 23.0 + 4.0);
	if (Roll > 0.16 * Amount * (0.4 + Age))
	{
		return float2(0, 0);
	}
	float2 Size = float2(lerp(0.5, 1.4, DgHash(Cell + 1.7)), lerp(0.4, 0.9, DgHash(Cell + 8.1)));
	float2 Centre = (Cell + 0.15 + 0.7 * float2(DgHash(Cell + 3.3), DgHash(Cell + 6.6))) * float2(1.7, 1.3);
	float2 Offset = abs(Wall - Centre) - Size * 0.5;
	float Ragged = (DgWearNoise(Wall, 23.0, 0.8) - 0.5) * 0.06 + (DgWearNoise(Wall, 7.0, 1.6) - 0.5) * 0.08;
	float Distance = max(Offset.x, Offset.y) + Ragged;
	float Width = max(0.012, fwidth(Distance) * 1.5);
	float Inside = 1.0 - smoothstep(0.0, Width, Distance);
	float Edge = Inside * smoothstep(-0.05 - Width, -0.05, Distance);
	return float2(Inside, Edge);
}

/**
 * All weathering effects on one pixel of a facade. Color (linear), Roughness and the wall position Wall (u, h in metres) come
 * from the facade surface; Seed is the building's variation value, WorldNormalY the wall's world normal (north is negative).
 * Age 0 to 1 is how worn the building is. The amounts scale each effect for the material class (clinker takes less fading,
 * render more flaking, a clean plinth less dirt). Spacing and FloorHeight are the window grid the streaks line up with.
 */
FDgFacadeWeathering DgFacadeWeather(Texture2D Atlas, SamplerState AtlasSampler, Texture2D Moss, SamplerState MossSampler,
	Texture2D Flake, SamplerState FlakeSampler, float3 Color, float Roughness, float2 Wall, float Seed, float WorldNormalY,
	float Age, float StreakAmount, float PlinthAmount, float MossAmount, float RepairAmount, float FadeAmount, float FlakeAmount,
	float PlinthHeight, float Spacing, float FloorHeight, float3 RepairColor)
{
	FDgFacadeWeathering Result;
	Result.Color = Color;
	Result.Roughness = Roughness;
	Result.NormalTilt = 0;
	float2 WallDx = ddx(Wall);
	float2 WallDy = ddy(Wall);
	float Luma = dot(Color, float3(0.2126, 0.7152, 0.0722));

	// Faded paint: sun-bleached patches lose saturation and gain a little brightness.
	float FadeNoise = DgWearNoise(Wall + Seed * 7.0, 0.35, 0.4) * 0.6 + DgWearNoise(Wall + Seed * 3.0, 1.1, 1.5) * 0.4;
	float Fade = saturate((FadeNoise - 0.35) * 1.8) * FadeAmount * Age;
	Result.Color = lerp(Result.Color, Luma.xxx * 1.12, Fade * 0.35);

	// Paint flaking off at the foot and in damp patches, showing the substrate scan underneath.
	float FlakeNoise = DgWearNoise(Wall + Seed * 19.0, 2.7, 0.8) * 0.55 + DgWearNoise(Wall, 9.0, 2.0) * 0.30 + DgWearNoise(Wall, 31.0, 0.3) * 0.15;
	float FlakeBias = (1.0 - saturate(Wall.y / 2.5)) * 0.12;
	float FlakeWidth = max(0.05, fwidth(FlakeNoise) * 1.5);
	float Flaked = smoothstep(0.78 - FlakeBias * Age, 0.78 - FlakeBias * Age + FlakeWidth, FlakeNoise) * FlakeAmount * Age;
	float3 Substrate = Texture2DSample(Flake, FlakeSampler, Wall / 1.6).rgb;
	Result.Color = lerp(Result.Color, Substrate * Luma / max(dot(Substrate, 0.333), 1e-3) * 0.9, Flaked);
	Result.Roughness = lerp(Result.Roughness, 0.95, Flaked);
	Result.NormalTilt += float2(DgWearNoise(Wall + 0.03, 40.0, 0.2) - DgWearNoise(Wall - 0.03, 40.0, 0.2),
		DgWearNoise(Wall + 0.03, 40.0, 1.4) - DgWearNoise(Wall - 0.03, 40.0, 1.4)) * Flaked * 0.6;

	// Repaired patches.
	float2 Repair = DgRepairs(Wall, Seed, RepairAmount, Age);
	float Grain = lerp(0.88, 1.08, DgWearNoise(Wall, 13.0, 1.1));
	Result.Color = lerp(Result.Color, RepairColor * Grain, Repair.x * 0.9);
	Result.Color *= 1.0 - Repair.y * 0.25;
	Result.Roughness = lerp(Result.Roughness, 0.93, Repair.x);
	Result.NormalTilt += float2(DgWearNoise(Wall + 0.02, 55.0, 0.6) - DgWearNoise(Wall - 0.02, 55.0, 0.6),
		DgWearNoise(Wall + 0.02, 55.0, 1.9) - DgWearNoise(Wall - 0.02, 55.0, 1.9)) * Repair.y * 1.1;

	// Rain: sill streaks and the faint wash.
	float Streaks = DgSillStreaks(Atlas, AtlasSampler, Wall, WallDx, WallDy, Seed, Spacing, FloorHeight, Age);
	float Wash = DgRainWash(Wall, Seed, Age);
	float Rain = saturate(Streaks * StreakAmount + Wash * StreakAmount);
	Result.Color *= lerp(float3(1, 1, 1), float3(0.52, 0.50, 0.46), Rain * 0.85);
	Result.Roughness = lerp(Result.Roughness, saturate(Result.Roughness + 0.12), Rain);

	// Algae film and moss.
	float Clumps;
	float Film = DgAlgae(Wall, Seed, WorldNormalY, Age, Clumps) * MossAmount;
	Result.Color = lerp(Result.Color, Result.Color * float3(0.46, 0.58, 0.34) + float3(0.0, 0.004, 0.0), Film * 0.65);
	float4 MossSample = Texture2DSample(Moss, MossSampler, Wall / 0.6);
	float MossAmountHere = Clumps * MossAmount * saturate(MossSample.a * 1.6);
	Result.Color = lerp(Result.Color, MossSample.rgb * float3(0.7, 0.8, 0.55), MossAmountHere);
	Result.Roughness = lerp(Result.Roughness, 0.92, saturate(Film * 0.5 + MossAmountHere));

	// The foot of the wall.
	float Dirt = DgPlinthDirt(Atlas, AtlasSampler, Wall, WallDx, WallDy, PlinthHeight, Age) * PlinthAmount;
	Result.Color = lerp(Result.Color, Result.Color * float3(0.36, 0.33, 0.29), Dirt * 0.85);
	Result.Roughness = lerp(Result.Roughness, 0.95, Dirt);
	return Result;
}
