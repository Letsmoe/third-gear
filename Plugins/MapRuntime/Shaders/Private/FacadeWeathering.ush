#pragma once
// Weathering of facade materials (Scripts/create_facade_materials.py, #84): rain streaks below sills, a dirty and splashed
// plinth, algae and moss on north faces and low wet areas, render and mortar repairs, faded and flaking paint. Nothing
// repeats: every effect is placed by hashing cells of the wall, seeded by the building's variation value, the way the road
// cracks are (RoadCracks.ush). Needs TerrainNoise.ush and MarkingWear.ush (DgWearNoise: rotated octaves that fade out under
// minification, so distant walls don't shimmer).
//
// Wall space: u metres along the wall, h metres above the building's base (the mesher's UV is (u, -h)).

#define DG_ATLAS_COLUMNS 4.0
#define DG_ATLAS_ROWS 2.0

// What the weathering changes at one pixel.
struct FDgFacadeWeathering
{
	float3 Color;
	float Roughness;
	float2 NormalTilt;
};

/** Atlas tile Index (0..7) at tile-local coordinates in 0..1, sampled with explicit gradients so cell borders keep their mip. */
float DgAtlasMask(Texture2D Atlas, SamplerState AtlasSampler, float Index, float2 Local, float2 GradientX, float2 GradientY)
{
	float2 Origin = float2(fmod(Index, DG_ATLAS_COLUMNS), floor(Index / DG_ATLAS_COLUMNS));
	float2 Uv = (Origin + saturate(Local)) / float2(DG_ATLAS_COLUMNS, DG_ATLAS_ROWS);
	float2 Scale = 1.0 / float2(DG_ATLAS_COLUMNS, DG_ATLAS_ROWS);
	return Atlas.SampleGrad(AtlasSampler, Uv, GradientX * Scale, GradientY * Scale).r;
}

/**
 * One streak hanging from a ledge: the shape from atlas tile Tile, Width metres wide centred at CentreU, running Length metres
 * down from LedgeHeight. Returns its darkening 0..1 at Wall (u, h).
 */
float DgLedgeStreak(Texture2D Atlas, SamplerState AtlasSampler, float2 Wall, float2 WallDx, float2 WallDy, float Tile,
	float CentreU, float Width, float LedgeHeight, float Length)
{
	float2 Local = float2((Wall.x - CentreU) / Width * 0.5 + 0.5, (LedgeHeight - Wall.y) / Length);
	if (Local.y < -0.05 || Local.y > 1.0 || Local.x < 0.0 || Local.x > 1.0)
	{
		return 0.0;
	}
	// The atlas shapes carry the ledge in the upper third; the drips run down from there.
	float2 Source = float2(Local.x, lerp(0.30, 1.0, saturate(Local.y)));
	float2 SourceDx = float2(WallDx.x / (Width * 2.0), WallDx.y / Length * 0.7);
	float2 SourceDy = float2(WallDy.x / (Width * 2.0), WallDy.y / Length * 0.7);
	return DgAtlasMask(Atlas, AtlasSampler, Tile, Source, SourceDx, SourceDy) * smoothstep(-0.05, 0.05, Local.y);
}

/**
 * Dark streaks running down from the sill of each window (cell: one window column of width Spacing, one floor of height
 * FloorHeight, the same grid as the painted windows), so they line up with windows without being stamped under every one,
 * and from the cornice (EaveHeight) in cells of about 2 m. A cell holds a streak with a probability that grows with Age; it
 * picks one of two atlas shapes, its width, length and a sideways shift. Returns the darkening 0..1.
 */
float DgRainStreaks(Texture2D Atlas, SamplerState AtlasSampler, float2 Wall, float2 WallDx, float2 WallDy, float Seed,
	float Spacing, float FloorHeight, float EaveHeight, float Age)
{
	float Floor = floor(Wall.y / FloorHeight);
	float Column = floor(Wall.x / Spacing);
	float Streak = 0.0;
	// This floor's sill streak, and the one from the floor above that is long enough to reach down here.
	[unroll]
	for (int Above = 0; Above < 2; ++Above)
	{
		float2 Cell = float2(Column, Floor + Above);
		if (DgHash(Cell + Seed * 17.3) > 0.2 + 0.6 * Age)
		{
			continue;
		}
		float Width = lerp(0.25, 0.55, DgHash(Cell + 2.2)) * Spacing * 0.5 * (0.7 + 0.5 * Age);
		float Length = lerp(0.9, 2.4, DgHash(Cell + 5.5)) * (0.6 + 0.6 * Age);
		float Centre = (Column + 0.5 + (DgHash(Cell + 9.9) - 0.5) * 0.2) * Spacing;
		float Tile = DgHash(Cell + Seed * 3.1 + 7.7) < 0.5 ? 1.0 : 2.0;
		Streak = max(Streak, DgLedgeStreak(Atlas, AtlasSampler, Wall, WallDx, WallDy, Tile, Centre, Width,
			(Floor + Above + 0.32) * FloorHeight, Length));
	}
	// Cornice and parapet: wider streaks from the top edge, within 4 m of it.
	if (EaveHeight - Wall.y < 4.5 && EaveHeight > 2.0)
	{
		float CornicePitch = 2.1;
		float CorniceColumn = floor(Wall.x / CornicePitch + Seed * 5.0);
		float2 Cell = float2(CorniceColumn, 77.0);
		if (DgHash(Cell + Seed * 11.0) < 0.15 + 0.5 * Age)
		{
			float Centre = (CorniceColumn - Seed * 5.0 + 0.5 + (DgHash(Cell + 4.4) - 0.5) * 0.3) * CornicePitch;
			float Width = lerp(0.35, 0.9, DgHash(Cell + 1.3));
			float Length = lerp(1.5, 3.8, DgHash(Cell + 6.1)) * (0.6 + 0.6 * Age);
			Streak = max(Streak, 0.8 * DgLedgeStreak(Atlas, AtlasSampler, Wall, WallDx, WallDy, 0.0, Centre, Width, EaveHeight, Length));
		}
	}
	return Streak;
}

/** Long faint rain wash down the whole wall: stretched noise, stronger near the top where the water has run furthest. */
float DgRainWash(float2 Wall, float Seed, float Age)
{
	float Stretched = DgWearNoise(Wall * float2(1.0, 0.12) + Seed * 31.0, 5.5, 0.15) * 0.6
		+ DgWearNoise(Wall * float2(1.0, 0.2) + Seed * 11.0, 17.0, 0.55) * 0.4;
	return saturate((Stretched - 0.45) * 2.2) * Age * 0.4;
}

/** Splash and dirt at the foot of the wall, up to PlinthHeight metres: 0..1, densest at the ground, with a ragged upper edge. */
float DgPlinthDirt(Texture2D Atlas, SamplerState AtlasSampler, float2 Wall, float2 WallDx, float2 WallDy, float PlinthHeight, float Age)
{
	if (Wall.y > PlinthHeight * 2.2)
	{
		return 0.0;
	}
	float Ragged = DgWearNoise(Wall, 3.1, 0.7) * 0.6 + DgWearNoise(Wall, 9.3, 1.9) * 0.4;
	float Band = 1.0 - smoothstep(0.0, PlinthHeight * (0.6 + 0.8 * Ragged), Wall.y);
	float2 Local = frac(Wall / 1.3);
	float Dots = DgAtlasMask(Atlas, AtlasSampler, 4.0, Local, WallDx / 1.3, WallDy / 1.3);
	float Splash = Dots * (1.0 - smoothstep(0.0, PlinthHeight * 1.8, Wall.y));
	return saturate(Band * (0.45 + 0.4 * Age) + Splash * 0.5 * Age);
}

/**
 * Algae and moss: more on faces turned away from the sun (north is -y in this world, WorldNormalY < 0), near the ground where
 * water collects, and in damp patches. Returns the algae film 0..1 and, in Clumps, where actual moss grows.
 */
float DgAlgae(float2 Wall, float Seed, float WorldNormalY, float Age, out float Clumps)
{
	Clumps = 0.0;
	float North = saturate(-WorldNormalY * 0.8 + 0.2);
	float Low = saturate(1.0 - Wall.y / 1.6);
	float Damp = DgWearNoise(Wall + Seed * 13.0, 0.55, 0.3) * 0.65 + DgWearNoise(Wall + Seed * 5.0, 1.9, 1.3) * 0.35;
	float Film = saturate((Damp * 0.6 + North * 0.5 + Low * 0.25 - 0.8) * 3.0) * Age;
	if (Film > 0.35 && Wall.y < 1.2)
	{
		float ClumpNoise = DgWearNoise(Wall, 11.0, 0.9) * 0.55 + DgWearNoise(Wall, 27.0, 2.3) * 0.45;
		float Wide = max(0.1, fwidth(ClumpNoise) * 1.5);
		Clumps = smoothstep(0.62, 0.62 + Wide, ClumpNoise) * saturate((Film - 0.35) * 2.0) * saturate(1.0 - Wall.y / 1.2);
	}
	return Film;
}

/**
 * Repairs: patches of render or mortar, 0.4 to 1.2 m wide, in cells of the wall, with a ragged border. x = inside a patch,
 * y = its edge (a chipped, slightly raised border).
 */
float2 DgRepairs(float2 Wall, float Seed, float Amount, float Age)
{
	float2 Cell = floor(Wall / float2(1.9, 1.5));
	if (DgHash(Cell + Seed * 23.0 + 4.0) > 0.06 * Amount * (0.4 + Age))
	{
		return float2(0, 0);
	}
	float2 Size = float2(lerp(0.4, 1.2, DgHash(Cell + 1.7)), lerp(0.3, 0.8, DgHash(Cell + 8.1)));
	float2 Centre = (Cell + 0.2 + 0.6 * float2(DgHash(Cell + 3.3), DgHash(Cell + 6.6))) * float2(1.9, 1.5);
	float2 Offset = abs(Wall - Centre) - Size * 0.5;
	float Ragged = (DgWearNoise(Wall, 17.0, 0.8) - 0.5) * 0.09 + (DgWearNoise(Wall, 6.0, 1.6) - 0.5) * 0.14;
	float Distance = length(max(Offset, 0.0)) + min(max(Offset.x, Offset.y), 0.0) + Ragged;
	float Width = max(0.012, fwidth(Distance) * 1.5);
	float Inside = 1.0 - smoothstep(0.0, Width, Distance);
	float Edge = Inside * smoothstep(-0.05 - Width, -0.05, Distance);
	return float2(Inside, Edge);
}

/**
 * All weathering effects on one pixel of a facade. Color (linear), Roughness and the wall position Wall (u, h in metres) come
 * from the facade surface; Seed is the building's variation value, WorldNormalY the wall's world normal (north is negative),
 * EaveHeight the wall's top in metres. Age 0 to 1 is how worn the building is. The amounts scale each effect for the material
 * class (clinker takes less fading, render more flaking, a clean plinth less dirt). Spacing and FloorHeight are the window grid
 * the streaks line up with. Effects with an amount of 0 cost nothing, and fine ones switch off where a pixel covers over 6 cm.
 */
FDgFacadeWeathering DgFacadeWeather(Texture2D Atlas, SamplerState AtlasSampler, Texture2D Moss, SamplerState MossSampler,
	Texture2D Flake, SamplerState FlakeSampler, float3 Color, float Roughness, float2 Wall, float Seed, float WorldNormalY,
	float EaveHeight, float Age, float StreakAmount, float PlinthAmount, float MossAmount, float RepairAmount, float FadeAmount,
	float FlakeAmount, float PlinthHeight, float Spacing, float FloorHeight, float3 RepairColor)
{
	FDgFacadeWeathering Result;
	Result.Color = Color;
	Result.Roughness = Roughness;
	Result.NormalTilt = 0;
	float2 WallDx = ddx(Wall);
	float2 WallDy = ddy(Wall);
	float Luma = dot(Color, float3(0.2126, 0.7152, 0.0722));
	bool bClose = max(length(WallDx), length(WallDy)) < 0.06;

	// Faded paint: sun-bleached patches lose saturation and gain a little brightness.
	if (FadeAmount > 0.001)
	{
		float FadeNoise = DgWearNoise(Wall + Seed * 7.0, 0.35, 0.4) * 0.6 + DgWearNoise(Wall + Seed * 3.0, 1.1, 1.5) * 0.4;
		float Fade = saturate((FadeNoise - 0.35) * 1.8) * FadeAmount * Age;
		Result.Color = lerp(Result.Color, Luma.xxx * 1.12, Fade * 0.35);
	}

	// Paint flaking off at the foot and in damp patches, showing the substrate scan underneath.
	if (FlakeAmount > 0.001 && bClose)
	{
		float FlakeNoise = DgWearNoise(Wall + Seed * 19.0, 2.7, 0.8) * 0.55 + DgWearNoise(Wall, 9.0, 2.0) * 0.30 + DgWearNoise(Wall, 31.0, 0.3) * 0.15;
		float FlakeBias = (1.0 - saturate(Wall.y / 2.5)) * 0.12;
		float FlakeWidth = max(0.05, fwidth(FlakeNoise) * 1.5);
		float Flaked = smoothstep(0.78 - FlakeBias * Age, 0.78 - FlakeBias * Age + FlakeWidth, FlakeNoise) * FlakeAmount * Age;
		if (Flaked > 0.001)
		{
			float3 Substrate = Texture2DSample(Flake, FlakeSampler, Wall / 1.6).rgb;
			Result.Color = lerp(Result.Color, Substrate * Luma / max(dot(Substrate, 0.333), 1e-3) * 0.9, Flaked);
			Result.Roughness = lerp(Result.Roughness, 0.95, Flaked);
			Result.NormalTilt += float2(DgWearNoise(Wall + 0.03, 40.0, 0.2) - DgWearNoise(Wall - 0.03, 40.0, 0.2),
				DgWearNoise(Wall + 0.03, 40.0, 1.4) - DgWearNoise(Wall - 0.03, 40.0, 1.4)) * Flaked * 0.6;
		}
	}

	// Repaired patches: the same surface, patched with a duller mortar or render that keeps some of the texture below.
	if (RepairAmount > 0.001)
	{
		float2 Repair = DgRepairs(Wall, Seed, RepairAmount, Age);
		if (Repair.x > 0.001)
		{
			float Grain = lerp(0.9, 1.08, DgWearNoise(Wall, 3.3, 1.1)) * lerp(0.94, 1.04, DgWearNoise(Wall, 31.0, 0.4));
			float3 Patched = RepairColor * Grain * lerp(0.85, 1.15, saturate(Luma * 3.0));
			Result.Color = lerp(Result.Color, Patched, Repair.x * 0.6);
			Result.Color *= 1.0 - Repair.y * 0.18;
			Result.Roughness = lerp(Result.Roughness, 0.93, Repair.x * 0.6);
			Result.NormalTilt += float2(DgWearNoise(Wall + 0.05, 14.0, 0.6) - DgWearNoise(Wall - 0.05, 14.0, 0.6),
				DgWearNoise(Wall + 0.05, 14.0, 1.9) - DgWearNoise(Wall - 0.05, 14.0, 1.9)) * Repair.y * 0.5;
		}
	}

	// Rain: sill and cornice streaks and the faint wash.
	if (StreakAmount > 0.001)
	{
		float Streaks = DgRainStreaks(Atlas, AtlasSampler, Wall, WallDx, WallDy, Seed, Spacing, FloorHeight, EaveHeight, Age);
		float Rain = saturate((Streaks + DgRainWash(Wall, Seed, Age)) * StreakAmount);
		Result.Color *= lerp(float3(1, 1, 1), float3(0.42, 0.40, 0.37), Rain * 0.8);
		Result.Roughness = lerp(Result.Roughness, saturate(Result.Roughness + 0.12), Rain);
	}

	// Algae film and moss.
	if (MossAmount > 0.001)
	{
		float Clumps;
		float Film = DgAlgae(Wall, Seed, WorldNormalY, Age, Clumps) * MossAmount;
		Result.Color = lerp(Result.Color, Result.Color * float3(0.55, 0.64, 0.40) + float3(0.0, 0.003, 0.0), Film * 0.5);
		Result.Roughness = lerp(Result.Roughness, 0.92, saturate(Film * 0.4));
		if (Clumps > 0.001 && bClose)
		{
			float4 MossSample = Texture2DSample(Moss, MossSampler, Wall / 0.6);
			float MossHere = Clumps * MossAmount * saturate(MossSample.a * 1.6);
			Result.Color = lerp(Result.Color, MossSample.rgb * float3(0.7, 0.8, 0.55), MossHere);
			Result.Roughness = lerp(Result.Roughness, 0.92, MossHere);
		}
	}

	// The foot of the wall: dark brown splash and dirt.
	if (PlinthAmount > 0.001)
	{
		float Dirt = DgPlinthDirt(Atlas, AtlasSampler, Wall, WallDx, WallDy, PlinthHeight, Age) * PlinthAmount;
		Result.Color = lerp(Result.Color, Result.Color * float3(0.38, 0.35, 0.31), Dirt * 0.8);
		Result.Roughness = lerp(Result.Roughness, 0.95, Dirt);
	}
	return Result;
}
