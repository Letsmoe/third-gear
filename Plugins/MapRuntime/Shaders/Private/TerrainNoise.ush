// Helpers for material Custom nodes (included via IncludeFilePaths "/Plugin/MapRuntime/Private/TerrainNoise.ush").
#pragma once

float DgHash(float2 q)
{
	q = frac(q * float2(123.34, 456.21));
	q += dot(q, q + 45.32);
	return frac(q.x * q.y);
}

// Smooth value noise in [0, 1], one feature per unit.
float DgValueNoise(float2 q)
{
	float2 i = floor(q);
	float2 f = frac(q);
	f = f * f * (3 - 2 * f);
	return lerp(lerp(DgHash(i), DgHash(i + float2(1, 0)), f.x), lerp(DgHash(i + float2(0, 1)), DgHash(i + 1), f.x), f.y);
}

// One terrain layer, sampled at two scales/rotations (mixed by detailMix to hide tiling) and accumulated with weight W
// into col/nrm/rough (colour multiplied by TINT). Expects p (UV in metres), rot and detailMix in scope; C/N/R are Custom-node texture inputs.
#define DG_LAYER(C, N, R, T, TINT, W) \
	if (W > 0.001) \
	{ \
		float2 ua = p / T; \
		float2 ub = mul(rot, p) / (T * 3.7); \
		float3 ca = Texture2DSample(C, C##Sampler, ua).rgb; \
		float3 cb = Texture2DSample(C, C##Sampler, ub).rgb; \
		float2 na = Texture2DSample(N, N##Sampler, ua).xy * 2 - 1; \
		float2 nb = Texture2DSample(N, N##Sampler, ub).xy * 2 - 1; \
		col += lerp(ca, cb * dot(ca, 0.333) / max(dot(cb, 0.333), 1e-3), detailMix * 0.6) * TINT * W; \
		nrm += float3(lerp(na, nb, detailMix * 0.5), 0) * W; \
		rough += Texture2DSample(R, R##Sampler, ua).r * W; \
	}
