# No trailing slashes below: most of these are links, and a trailing slash only matches real directories,
# so `git add -A` would commit the links.

# Links into the data root (Tools/bootstrap/data_root.py): downloads, geodata, world data, Python environments,
# the derived data cache and the Unreal content that isn't ours to publish or is generated.
/External
/DerivedDataCache
Tools/**/.venv
/Content/Audio
/Content/CitySampleVehicles
/Content/Textures
/Content/Vegetation
/Content/Grass
/Content/Leaves
/Content/Megascans
/Content/World

# Plugin build output
Plugins/*/Binaries/
Plugins/*/Intermediate/
# Patched copy of the engine's OpenXR plugin: engine source can't be published.
# Created by Scripts/setup_openxr_plugin.sh from Patches/openxr-swapchain-flags.patch.
/Plugins/OpenXR

Tools/wheeltest/wheeltest

# Left over from before the data root; safe to delete once the data root is set up.
/RawAssets
/GeoData/raw
/GeoData/osm
/GeoData/build
/Content/Vehicles/SportsCar
/Content/Vehicles/PhysicsMaterials
/Content/Vehicles/TrafficPaint

# Editor clutter and generated maps; ProvingGround is ours and tracked.
/Content/Collections
/Content/Developers
Content/Maps/*
!Content/Maps/ProvingGround.umap
!Content/Maps/Streamed.umap
