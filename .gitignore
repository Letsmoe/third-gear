# Created by Scripts/setup_openxr_plugin.sh from Patches/openxr-swapchain-flags.patch.
/Plugins/OpenXR

# Large raw downloads (re-fetchable with Tools/asset_fetch and Tools/geodata)
RawAssets/*
!RawAssets/MANIFEST.md
/GeoData/raw
/GeoData/osm
# Generated by Tools/osmimport
/GeoData/build
Tools/**/.venv
Tools/wheeltest/wheeltest

# No trailing slashes: worktrees have links in these places (Scripts/new_worktree.sh), and a trailing slash
# only matches real directories, so `git add -A` in a worktree would commit the links.

# Third-party and generated Unreal content (see README.md "Setup")
/Content/CitySampleVehicles
/Content/Textures
/Content/World
/Content/Vegetation
/Content/Vehicles/SportsCar
/Content/Vehicles/PhysicsMaterials
/Content/Collections
/Content/Developers
Content/Maps/*
!Content/Maps/ProvingGround.umap
